{
  "name": "ibeji",
  "version": "0.1.0",
  "description": "Local twins of payment services for safe payment, webhook and AI-agent testing.",
  "license": "MIT",
  "author": "Joseph Brendan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joseph-Brendan/ibeji.git"
  },
  "homepage": "https://github.com/Joseph-Brendan/ibeji#readme",
  "bugs": {
    "url": "https://github.com/Joseph-Brendan/ibeji/issues"
  },
  "keywords": [
    "paystack",
    "flutterwave",
    "testing",
    "webhooks",
    "ai-agents",
    "mcp",
    "nigeria",
    "africa",
    "payments"
  ],
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "pnpm@10.34.9",
  "bin": {
    "ibeji": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "scenarios/",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "build": "tsup && pnpm build:ui",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "check:package": "node scripts/check-package.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "example:paystack:naive": "node examples/school-fees-app/run.js paystack naive",
    "example:paystack:safe": "node examples/school-fees-app/run.js paystack safe",
    "example:flutterwave:naive": "node examples/school-fees-app/run.js flutterwave naive",
    "example:flutterwave:safe": "node examples/school-fees-app/run.js flutterwave safe",
    "dev": "tsup --watch",
    "build:ui": "pnpm prepare:ui && vite build",
    "dev:ui": "pnpm prepare:ui && vite",
    "prepare:ui": "node scripts/prepare-ui-fonts.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@changesets/cli": "3.0.3",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "4.10.2",
    "flutterwave-node-v3": "1.4.1",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/server": "2.4.0",
    "hono": "4.13.14",
    "open": "11.0.4",
    "zod": "4.6.7"
  }
}
